{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centurion.local/schemas/open-design-reference-request.v1.json",
  "title": "CENTURION Reference Request V1",
  "type": "object",
  "required": ["requestVersion", "query"],
  "properties": {
    "requestVersion": { "const": "CENTURION_REFERENCE_REQUEST_V1" },
    "searchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "query": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "artifactType": { "type": "string", "minLength": 1, "maxLength": 256 },
    "platform": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["shadcn", "magicui", "hyperui", "tabler", "landbook"] }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
    "cacheMaxAgeHours": { "type": "integer", "minimum": 1, "maximum": 720, "default": 24 }
  },
  "additionalProperties": false
}
