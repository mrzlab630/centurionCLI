{
  "name": "antigravity-legion-kit",
  "version": "0.2.1",
  "private": true,
  "description": "Portable CENTURION Legion rules, workflows, and MCP bridge for Google Antigravity.",
  "type": "module",
  "bin": {
    "centurion-legion-mcp": "./mcp-server/index.mjs",
    "install-antigravity-legion": "./installer/install.mjs"
  },
  "scripts": {
    "smoke": "node ./scripts/smoke.mjs",
    "catalog:check": "node ./scripts/refresh-external-catalog.mjs --check",
    "catalog:refresh": "node ./scripts/refresh-external-catalog.mjs --write",
    "frontend-catalog:check": "node ./scripts/refresh-frontend-catalog.mjs --check",
    "frontend-catalog:refresh": "node ./scripts/refresh-frontend-catalog.mjs --write",
    "frontend-reference:check": "node ./scripts/refresh-frontend-reference-index.mjs --check",
    "frontend-reference:refresh": "node ./scripts/refresh-frontend-reference-index.mjs --write",
    "content-catalog:check": "node ./scripts/refresh-content-catalog.mjs --check",
    "content-catalog:refresh": "node ./scripts/refresh-content-catalog.mjs --write",
    "agy-plugin:validate": "agy plugin validate ./agy-plugin",
    "legion:eval": "node ./scripts/smoke.mjs --report",
    "install:local": "node ./installer/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
